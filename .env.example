# ==============================================================================
# CrowdWisdomTrading - Environment Configuration Template
# Copy this file to .env and populate your active API keys
# ==============================================================================

# Apify API Token & Actor ID (https://apify.com/)
# Recommended actors:
#   - 'apidojo/tweet-scraper'
#   - 'shu8hvrXbJbY3Eb9W' (Twitter Scraper)
#   - 'kaitoeasyapi/twitter-x-data-tweet-scraper-fast-cheapest'
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=apidojo/tweet-scraper

# Tavily AI Search API Key (https://tavily.com/)
# Used for real-time news retrieval and fundamental catalyst sentiment
TAVILY_API_KEY=tvly-your_tavily_key_here

# Exa.ai API Key (https://exa.ai/ - Optional / Alternative news provider)
EXA_API_KEY=your_exa_api_key_here

# Asset & Target Configuration
TARGET_ASSET=BTC-USD
TARGET_TIMEFRAME=1h
LOOKBACK_DAYS=180
TIMEZONE=UTC

# Execution Mode: Set to True to allow synthetic/cached replay if no API credits
ALLOW_MOCK_FALLBACK=True
DATABASE_PATH=data_cache/market_sentiment.db

